{
  "name": "alpaca-trading-dashboard",
  "version": "1.0.0",
  "description": "Stock trading dashboard MVP using Alpaca Markets API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron electron/main.js",
    "electron:dev": "electron electron/main.js --dev",
    "generate:icons": "node scripts/generate-icons.cjs",
    "test": "vitest run",
    "check:icons": "npm run generate:icons && git diff --exit-code -- assets/icon.png assets/icon.ico",
    "build:ci": "npm run generate:icons && electron-builder --dir --publish never",
    "check:all": "npm test && npm run check:icons && npm run build:ci",
    "postinstall": "node scripts/install-hooks.cjs",
    "build": "node scripts/build.cjs",
    "build:desktop": "npm run generate:icons && electron-builder",
    "build:linux": "npm run generate:icons && electron-builder --linux",
    "build:win": "npm run generate:icons && electron-builder --win",
    "build:mac": "npm run generate:icons && electron-builder --mac"
  },
  "build": {
    "appId": "com.alpaca.trading-dashboard",
    "productName": "Alpaca Trading Dashboard",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "src/**",
      "public/**",
      ".env",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Finance",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeholp87/trading-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mikeholp87/trading-app/issues"
  },
  "homepage": "https://github.com/mikeholp87/trading-app#readme",
  "dependencies": {
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.0",
    "vitest": "^4.1.5"
  }
}
